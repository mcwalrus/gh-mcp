# Common .gitignore -- OS, editor, and environment patterns
# Combined with python.gitignore for a complete .gitignore

# -- macOS ------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# -- Linux ------------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -- Windows ----------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
*.stackdump

# -- Editors / IDEs ---------------------------------------------------------
# JetBrains
.idea/
*.iml
*.iws

# VS Code -- workspace settings are usually committed; exclude local overrides
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# Vim / Neovim
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# -- Environment / secrets ----------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# -- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# -- Distribution / packaging -------------------------------------------------
build/
dist/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/
share/python-wheels/

# -- Virtual environments -----------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# -- uv local cache (not the lockfile -- commit uv.lock) --------------------
.uv/

# -- Installer logs -----------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt

# -- Testing / coverage -------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# -- Tool caches --------------------------------------------------------------
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# -- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -- Framework-specific -------------------------------------------------------
# Streamlit
.streamlit/secrets.toml

# -- Documentation ------------------------------------------------------------
docs/_build/
